<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Enable instant app support -->
    <dist:module dist:instant="true" />

    <!-- Declare features -->
    <uses-feature android:name="android.hardware.camera" />

    <!-- Declare permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo_aplikasi"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_aplikasi"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:theme="@style/Theme.GestureRecognizer"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="AllowBackup">

        <activity
            android:name=".features.home.HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.GestureRecognizer.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Declare notch support -->
            <meta-data
                android:name="android.notch_support"
                android:value="true" />
        </activity>

        <activity
            android:name=".core.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer">

            <!-- Declare notch support -->
            <meta-data
                android:name="android.notch_support"
                android:value="true" />
        </activity>

        <activity
            android:name=".features.panduan.PanduanHijaiyahActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer">
        </activity>
        <activity
            android:name=".features.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer">
        </activity>
        
        <activity
            android:name=".features.auth.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer">
        </activity>
        
        <activity
            android:name=".features.hijaiyahdb.HijaiyahDBListActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer" />        <activity
            android:name=".features.latihan.LatihanDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer" />
        
        <activity
            android:name=".features.latihan.LatihanPracticeActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer" />

        <!-- Surat activities -->
        <activity
            android:name=".features.surat.SuratListActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer" />

        <activity
            android:name=".features.surat.SuratDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.GestureRecognizer" />


    </application>

</manifest>
