<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Room Name -->
        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelas Hijaiyah Pemula"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/hijaiyah_navy"
            android:layout_marginBottom="4dp"/>

        <!-- Room Description -->
        <TextView
            android:id="@+id/tvRoomDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hijaiyah Menjelaskan"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/hijaiyah_grey"
            android:layout_marginBottom="12dp"/>

        <!-- Room Code and Guru -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Room Code -->
                <TextView
                    android:id="@+id/tvRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kode: 95NHEG"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijaiyah_navy"
                    android:background="@drawable/rounded_button_yellow"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Guru Name -->
                <TextView
                    android:id="@+id/tvGuruName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guru: Ustadz Ahmad"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:drawablePadding="4dp"
                    android:layout_marginBottom="4dp"/>

                <!-- Joined Date -->
                <TextView
                    android:id="@+id/tvJoinedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bergabung: 16 Nov 2025"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>

            </LinearLayout>

            <!-- Arrow Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="@color/hijaiyah_navy"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
