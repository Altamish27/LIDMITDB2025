<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header with Back Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentLeft="true"
                android:background="@drawable/circle_button_background"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#147E7E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Panduan Latihan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333" />

        </RelativeLayout>

        <!-- Letter Display Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#147E7E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/textTargetLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ا"
                    android:textSize="80sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/textLetterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alif"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textDiacriticMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="#FCD94B"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Gesture Image Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contoh Isyarat"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#147E7E"
                    android:layout_marginBottom="16dp" />

                <!-- Gesture Image -->
                <ImageView
                    android:id="@+id/imageGestureGuide"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/praga_alif"
                    android:layout_marginBottom="12dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Instructions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cara Membuat Isyarat"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#147E7E"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Tunjukkan gesture huruf Hijaiyah\n2. Tahan posisi tangan tetap diam selama 1 detik\n3. Tunggu hingga deteksi selesai"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/textDiacriticInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#FF6B6B"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Start Practice Button -->
        <Button
            android:id="@+id/buttonStartPractice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mulai Latihan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#147E7E"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp" />

    </LinearLayout>

</ScrollView>
