<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Title -->
    <TextView
        android:id="@+id/textTutorialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panduan Gesture"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Arabic Letter Display -->
    <TextView
        android:id="@+id/textTutorialLetter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ا"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="#147E7E"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Letter Name -->
    <TextView
        android:id="@+id/textTutorialLetterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alif"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Gesture Image -->
    <ImageView
        android:id="@+id/imageTutorialGesture"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        android:src="@drawable/praga_alif"
        android:layout_marginBottom="16dp" />

    <!-- Instructions -->
    <TextView
        android:id="@+id/textTutorialInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cara melakukan gesture:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="12dp" />

    <!-- Instruction Steps -->
    <TextView
        android:id="@+id/textTutorialSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Tunjukkan gesture huruf Hijaiyah\n2. Tahan posisi tangan tetap diam selama 1 detik\n3. Tunggu hingga deteksi selesai"
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Additional Info for Diacritics -->
    <TextView
        android:id="@+id/textTutorialDiacriticInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#FF6B6B"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Close Button -->
    <Button
        android:id="@+id/buttonCloseTutorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mengerti"
        android:backgroundTint="#147E7E"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:paddingVertical="12dp" />

</LinearLayout>
