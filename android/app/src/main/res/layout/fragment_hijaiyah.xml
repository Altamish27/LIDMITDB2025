<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    


<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/header_gradient_background"
        android:padding="24dp">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginTop="8dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBack"
            android:layout_alignParentStart="true"
            android:text="HIJAIYAH HURUF"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <!-- Progress Text -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTitle"
            android:layout_alignParentStart="true"
            android:text="3 / 28 Huruf"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Progress Bar Container -->
        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvProgress"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:layout_marginEnd="16dp"
                android:progress="33"
                android:progressTint="@color/hijaiyah_yellow"
                android:progressBackgroundTint="@color/white"
                android:progressDrawable="@drawable/progress_bar_custom"/>

                    <!-- Progress Percentage -->
        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="33%"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:minWidth="48dp"
            android:gravity="end"/>
                
        </LinearLayout>

        <!-- Lamp Icon - Top Right -->
        <ImageView
            android:id="@+id/ivLampIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/huruf_hijaiyah"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Main Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:padding="16dp">
        
        <!-- "Mulai Belajar" Title -->
        <TextView
            android:id="@+id/tvMulaiBelajar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mulai Belajar"
            android:textColor="@color/hijaiyah_navy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Category Tabs (Horizontal) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryHijaiyah"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Hijaiyah"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/hijaiyah_green"
                    app:cornerRadius="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginEnd="8dp"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryFathah"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Fathah"
                    android:textSize="14sp"
                    android:textColor="@color/hijaiyah_navy"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/hijaiyah_navy"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginEnd="8dp"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryKasrah"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Kasrah"
                    android:textSize="14sp"
                    android:textColor="@color/hijaiyah_navy"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/hijaiyah_navy"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:layout_marginEnd="8dp"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryDhommah"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Dhommah"
                    android:textSize="14sp"
                    android:textColor="@color/hijaiyah_navy"
                    app:backgroundTint="@color/white"
                    app:strokeColor="@color/hijaiyah_navy"
                    app:strokeWidth="1dp"
                    app:cornerRadius="24dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Search Bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="2dp">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Cari Huruf Hijaiyah"
                android:textColorHint="@color/hijaiyah_navy"
                android:textColor="@color/hijaiyah_navy"
                android:textSize="13sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:singleLine="true"
                android:drawableEnd="@drawable/ic_search"
                android:drawableTint="@color/hijaiyah_navy"/>

        </androidx.cardview.widget.CardView>

        <!-- Letters Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>

</ScrollView>

</FrameLayout>
