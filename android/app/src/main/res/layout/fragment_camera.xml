<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillStart" />

    <!-- Gesture Overlay -->
    <com.google.mediapipe.examples.gesturerecognizer.core.overlay.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= TOP SECTION ================= -->
    <LinearLayout
        android:id="@+id/topSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@drawable/gradient_top_overlay"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="12dp"
        android:fitsSystemWindows="true">

        <!-- Header Row: Back & Help buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button_background"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/buttonHelp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_button_background"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_help"
                android:contentDescription="Bantuan"
                app:tint="#FFFFFF" />

        </LinearLayout>

        <!-- Current Letter Card (Compact) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_guidance_panel"
            android:padding="12dp">

            <!-- Letter Circle (Smaller) -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/letterCircleBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_letter_circle" />

                <TextView
                    android:id="@+id/textTargetLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="ا"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

            </FrameLayout>

            <!-- Letter Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textLetterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Huruf Alif"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textLetterType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Hijaiyah Dasar"
                    android:textColor="#B0FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textGestureHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🤚 Tunjukkan gesture"
                    android:textColor="#FCD94B"
                    android:textSize="11sp"
                    android:textStyle="italic" />

            </LinearLayout>

        </LinearLayout>

        <!-- ================= NEXT LETTERS LIST (MODE LATIHAN) ================= -->
        <!-- Positioned at TOP, horizontal, for latihan jilid mode -->
        <LinearLayout
            android:id="@+id/latihanModeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Huruf Selanjutnya"
                android:textSize="10sp"
                android:textColor="#B0FFFFFF"
                android:layout_marginBottom="4dp" />

            <!-- Container for next letters (horizontal) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_next_letters_row">

                <!-- Next Letter 1 -->
                <LinearLayout
                    android:id="@+id/nextLetter1Container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textNextLetter1"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="ب"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_next_letter_item" />

                </LinearLayout>

                <!-- Next Letter 2 -->
                <LinearLayout
                    android:id="@+id/nextLetter2Container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textNextLetter2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="ت"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_next_letter_item" />

                </LinearLayout>

                <!-- Next Letter 3 -->
                <LinearLayout
                    android:id="@+id/nextLetter3Container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textNextLetter3"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="ث"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_next_letter_item" />

                </LinearLayout>

                <!-- More indicator -->
                <TextView
                    android:id="@+id/textMoreLetters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textSize="16sp"
                    android:textColor="#80FFFFFF"
                    android:layout_marginStart="4dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ================= BOTTOM SECTION ================= -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/gradient_bottom_overlay"
        android:paddingTop="12dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp"
        android:fitsSystemWindows="true">

        <!-- Step Indicator for Harakat (Fathah, Kasrah, Dhammah) -->
        <LinearLayout
            android:id="@+id/stepIndicatorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_step_indicator"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <!-- Step 1: Gesture -->
            <LinearLayout
                android:id="@+id/step1Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <View
                        android:id="@+id/step1Circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number_active" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/step1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gesture"
                    android:textColor="#147E7E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#999999"
                android:textSize="16sp"
                android:layout_marginHorizontal="4dp" />

            <!-- Step 2: Movement -->
            <LinearLayout
                android:id="@+id/step2Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <View
                        android:id="@+id/step2Circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number_inactive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/step2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gerakan"
                    android:textColor="#999999"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Arrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="#999999"
                android:textSize="16sp"
                android:layout_marginHorizontal="4dp" />

            <!-- Step 3: Complete -->
            <LinearLayout
                android:id="@+id/step3Container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <View
                        android:id="@+id/step3Circle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_step_number_inactive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✓"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:id="@+id/step3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Selesai"
                    android:textColor="#999999"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Status Card (Compact) -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_waiting"
            android:padding="12dp"
            android:layout_marginBottom="6dp">

            <!-- Status Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/textStatusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Mendeteksi Gesture..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Status Message -->
            <TextView
                android:id="@+id/textStatusMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tahan gesture selama 1 detik"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:maxLines="2" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressTimer"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                style="?android:attr/progressBarStyleHorizontal"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_gesture_timer"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Detected Gesture Info (Small) -->
        <LinearLayout
            android:id="@+id/detectedGestureContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/results_background"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terdeteksi:"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textDetectedGesture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="-"
                android:textColor="#147E7E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textGestureMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❌"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Hidden RecyclerView for results (keep for compatibility) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Start Button (hidden by default) -->
        <Button
            android:id="@+id/buttonStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mulai Latihan"
            android:backgroundTint="#147E7E"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingVertical="10dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ================= SUCCESS OVERLAY ================= -->
    <RelativeLayout
        android:id="@+id/overlayResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="24dp"
            android:orientation="vertical"
            android:background="@drawable/result_background"
            android:padding="24dp"
            android:gravity="center">

            <!-- Success Icon -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_letter_circle_active" />

                <ImageView
                    android:id="@+id/iconResult"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#147E7E" />

            </FrameLayout>

            <TextView
                android:id="@+id/textResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="BERHASIL!"
                android:textColor="#147E7E"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textResultDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Anda berhasil memperagakan huruf dengan benar!"
                android:textColor="#666666"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Letter Display in Result -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_step_indicator"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/textResultLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ا"
                    android:textColor="#147E7E"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="#CCCCCC" />

                <TextView
                    android:id="@+id/textResultLetterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alif"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- Include bottom sheet for advanced settings (hidden by default) -->
    <include
        android:id="@+id/bottom_sheet_layout"
        layout="@layout/info_bottom_sheet"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
