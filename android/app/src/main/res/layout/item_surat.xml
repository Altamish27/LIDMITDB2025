<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Number badge on left -->
        <TextView
            android:id="@+id/tv_item_surat_number"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/circle_green"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Content container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tv_item_surat_number"
            android:layout_toStartOf="@id/tv_item_surat_arabic"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_item_surat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al-Maa'uun"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2C3E50" />

            <TextView
                android:id="@+id/tv_item_surat_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7 Ayat • Makiyah"
                android:textSize="12sp"
                android:textColor="#7F8C8D"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Arabic name on right -->
        <TextView
            android:id="@+id/tv_item_surat_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="الماعون"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#147E7E" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
